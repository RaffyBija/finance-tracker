# Copia in backend/.env e compila. Non committare mai il file .env reale.

# Postgres (obbligatorio: anche `prisma generate` legge lo schema e la richiede)
DATABASE_URL="postgresql://user:password@localhost:5432/finance_tracker?schema=public"

# Firma dei token JWT (obbligatorio: il server non parte senza). Es: openssl rand -hex 32
JWT_SECRET=""

PORT=3000
NODE_ENV=development

# Origini CORS ammesse, separate da virgola. Default (solo dev): http://localhost:5173
ALLOWED_ORIGINS="http://localhost:5173"

# URL pubblico del frontend, usato nei link delle email (verifica, reset password)
FRONTEND_URL="http://localhost:5173"

# Invio email via Resend
RESEND_API_KEY=""
SMTP_FROM="Finance Tracker <noreply@example.com>"
